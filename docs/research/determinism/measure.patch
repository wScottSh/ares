+inline auto measureFill(void* p, size_t n) -> void* {
+  static int pattern = [] { auto e = getenv("N64RUN_FILL"); return e ? (int)strtol(e, nullptr, 0) : -1; }();
+  if(p && pattern >= 0) ::memset(p, pattern, n);
+  return p;
+}
+
 template<typename T, u32 Align> auto allocate(u32 size) -> T* {
   if constexpr(Align == 0) {
-    return (T*)malloc(size * sizeof(T));
+    return (T*)measureFill(malloc(size * sizeof(T)), size * sizeof(T));
   }
   #if defined(API_WINDOWS)
-  return (T*)_aligned_malloc(size * sizeof(T), Align);
+  return (T*)measureFill(_aligned_malloc(size * sizeof(T), Align), size * sizeof(T));
   #elif defined(API_POSIX)
   T* result = nullptr;
   posix_memalign((void**)&result, Align, size * sizeof(T));
