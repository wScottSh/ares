+      measureProbe.counter[MeasureProbe::GpuCommands]++;
+      u32 hi = buffer[queueOffset * 2], lo = buffer[queueOffset * 2 + 1] & 0xffffff;
+      if(code == 0x3f) {
+        u32 width = (hi & 0x3ff) + 1, size = hi >> 19 & 3;
