+      } else if(code >= 0x08 && code <= 0x0f || code == 0x24 || code == 0x25 || code == 0x36) {
+        measureProbe.pending = true;
+      }
     }
 
     if(::RDP::Op(code) == ::RDP::Op::SyncFull) {
+      measureProbe.counter[MeasureProbe::SyncFullWaits]++;
