diff --git a/ares/n64/cpu/recompiler.cpp b/ares/n64/cpu/recompiler.cpp
index b84272aaf..08c1c99b2 100644
--- a/ares/n64/cpu/recompiler.cpp
+++ b/ares/n64/cpu/recompiler.cpp
@@ -718,7 +718,8 @@ auto CPU::Recompiler::emit(u64 vaddr, u32 address, u64 stateKey) -> Block* {
       }
     }
 
-    if(firstInstruction || (ii.vaddr & 0x1f) == 0) {
+    static bool diagAliasGuard = getenv("DIAG_ALIAS_GUARD") != nullptr;
+    if(firstInstruction || (ii.vaddr & 0x1f) == 0 || (diagAliasGuard && isInternalEntry)) {
       // Keep icache tag/coherency checks in sync with interpreter behavior.
       flushDeferredCycles();
       if(!self.icache.coherent(ii.vaddr, ii.address)) {
@@ -835,8 +836,18 @@ auto CPU::Recompiler::emit(u64 vaddr, u32 address, u64 stateKey) -> Block* {
       OpInfo info = self.decoderEXECUTEInfo(slow.instruction);
       if(info.branch()) setupPipeline();
       emitEXECUTE(slow.instruction, true, emitPcMode);
+      static bool diagSlowFix = getenv("DIAG_SLOW_FIX") != nullptr;
+      if(diagSlowFix) {
+        s64 P = slow.deferredCycles;
+        s64 R = u32(slow.deferredCycles + slow.instructionCycles);
+        s64 F = P - s64(emitDeferredCycles);
+        s64 extra = P + 2 - R - F;
+        if(extra) add64(CpuClockMem, CpuClockMem, imm(extra));
+        emitDeferredCycles = 0;
+      } else {
       emitDeferredCycles += slow.instructionCycles;
       flushDeferredCycles();
+      }
       if(!emitPipelineSetupDone) setupPipeline();
       test32(PipelineReg(state), imm(Pipeline::EndBlock), set_z);
       mov32(PipelineReg(state), PipelineReg(nstate));
diff --git a/ares/n64/system/system.cpp b/ares/n64/system/system.cpp
index 25b26ef33..8e784525b 100644
--- a/ares/n64/system/system.cpp
+++ b/ares/n64/system/system.cpp
@@ -39,9 +39,11 @@ auto option(string name, string value) -> bool {
   if(name == "Recompiler") {
     if constexpr(Accuracy::CPU::Recompiler) {
       cpu.recompiler.enabled = value.boolean();
+      if(auto e = getenv("DIAG_CPU_JIT")) cpu.recompiler.enabled = e[0] == '1';
     }
     if constexpr(Accuracy::RSP::Recompiler) {
       rsp.recompiler.enabled = value.boolean();
+      if(auto e = getenv("DIAG_RSP_JIT")) rsp.recompiler.enabled = e[0] == '1';
     }
   }
   if(Model::Nintendo64() && name == "Expansion Pak") system.expansionPak = value.boolean();
