+//measure-9 instrumentation (research only, never delivered)
+namespace m9 {
+  inline auto envInt(const char* name, s64 fallback) -> s64 {
+    auto value = std::getenv(name);
+    return value ? (s64)std::strtoll(value, nullptr, 10) : fallback;
+  }
+
+  inline bool prof     = envInt("M9_PROF", 0);
+  inline bool busSync  = envInt("M9_BUSSYNC", 0);
+  inline s64  jit      = envInt("M9_JIT", 2048 * 2);
+  inline s64  chunk    = envInt("M9_CHUNK", 0);
+  inline s64  rspMode  = envInt("M9_RSP", -1);  //-1 follow --cpu, 0 interpreter, 1 recompiler
+  inline bool inSync   = false;
+  inline s64  mode     = envInt("M9_MODE", 0);   //0 sync when instruction() asks, 1 horizon skip unless RSP runs, 2 batch
+  inline s64  batch    = envInt("M9_BATCH", 64);
+  inline s64  horizon  = 0;
+  inline s64  rspSynced = 0;
+
+  enum Slot : u32 { CpuStep, Sync, VI, AI, RSP, RDP, PIF, Queue, NumSlots };
+  inline const char* slotNames[] = {"cpu_step", "sync_total", "vi", "ai", "rsp", "rdp", "pif", "queue"};
+  inline u64 tsc[NumSlots];
+  inline u64 calls[NumSlots];
+
+  enum Txn : u32 {
+    CpuUncachedRdram, CpuRcpReg, CpuCart, CpuDcacheFill, CpuDcacheWB, CpuIcacheFill,
+    SpDmaRows, SpDmaBursts, SpDmaBytes, PiDmas, PiDmaBytes, SiDmas, AiReads,
+    RspInstr, RspHaltSteps, Syncs, BusSyncs, CpuInstr, Pieces, CpuInstrRspRun, RspOnlySyncs,
+    W2, W4, W8, W16, W64, W128, W512, W4096, WBig, NumTxn
+  };
+  inline const char* txnNames[] = {
+    "cpu_uncached_rdram", "cpu_rcp_reg", "cpu_cart", "cpu_dcache_fill", "cpu_dcache_wb", "cpu_icache_fill",
+    "sp_dma_rows", "sp_dma_bursts128", "sp_dma_bytes", "pi_dmas", "pi_dma_bytes", "si_dmas", "ai_reads",
+    "rsp_steps", "rsp_halt_steps", "syncs", "bus_syncs", "cpu_steps", "sync_pieces", "cpu_steps_rsp_running", "rsp_only_syncs",
+    "win_le2", "win_le4", "win_le8", "win_le16", "win_le64", "win_le128", "win_le512", "win_le4096", "win_gt4096"
+  };
+  inline u64 txn[NumTxn];
+
+  inline auto now() -> u64 { return prof ? __rdtsc() : 0; }
+}
