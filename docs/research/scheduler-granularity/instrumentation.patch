+inline auto m9SyncBeforeAccess() -> void {
+  if(m9::busSync && !m9::inSync) { m9::txn[m9::BusSyncs]++; cpu.synchronize(); }
+}
+
+inline auto m9Access(u32 address) -> void {
+  if(address <= 0x03ff'ffff) m9::txn[m9::CpuUncachedRdram]++;
+  else if(address <= 0x04ff'ffff) m9::txn[m9::CpuRcpReg]++;
+  else m9::txn[m9::CpuCart]++;
+  m9SyncBeforeAccess();
+}
+
+inline auto m9Burst(u32 kind) -> void {
+  m9::txn[kind]++;
+  m9SyncBeforeAccess();
+}
