diff --git a/tools/n64-run/m9-sampler.cpp b/tools/n64-run/m9-sampler.cpp
new file mode 100644
index 000000000..3d75c24b1
--- /dev/null
+++ b/tools/n64-run/m9-sampler.cpp
@@ -0,0 +1,61 @@
+//measure-9 sampling profiler (research only, never delivered)
+#include <windows.h>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <thread>
+#include <vector>
+
+namespace {
+  std::atomic<bool> running{false};
+  std::thread sampler;
+  std::vector<unsigned long long> samples;
+}
+
+void m9SamplerStart() {
+  if(!std::getenv("M9_SAMPLE")) return;
+  HANDLE target = nullptr;
+  DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &target,
+    THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, 0);
+  auto base = (unsigned long long)GetModuleHandleW(nullptr);
+  samples.reserve(1 << 20);
+  running = true;
+  sampler = std::thread([target, base] {
+    LARGE_INTEGER freq, start, now;
+    QueryPerformanceFrequency(&freq);
+    auto period = freq.QuadPart / 4000;
+    while(running) {
+      QueryPerformanceCounter(&start);
+      do { SwitchToThread(); QueryPerformanceCounter(&now); } while(now.QuadPart - start.QuadPart < period);
+      if(SuspendThread(target) == (DWORD)-1) continue;
+      CONTEXT context{};
+      context.ContextFlags = CONTEXT_CONTROL;
+      if(GetThreadContext(target, &context)) samples.push_back(context.Rip - base + 0x140000000ull);
+      ResumeThread(target);
+    }
+  });
+}
+
+void m9SamplerStop() {
+  if(!running) return;
+  running = false;
+  sampler.join();
+  auto path = std::getenv("M9_SAMPLE");
+  if(auto file = std::fopen(path, "wb")) {
+    for(auto rip : samples) std::fprintf(file, "%llx\n", rip);
+    std::fclose(file);
+  }
+}
+
+double m9ThreadCpuSeconds() {
+  FILETIME creation, exit, kernel, user;
+  GetThreadTimes(GetCurrentThread(), &creation, &exit, &kernel, &user);
+  auto ticks = [](FILETIME t) { return ((unsigned long long)t.dwHighDateTime << 32 | t.dwLowDateTime) / 1e7; };
+  return ticks(kernel) + ticks(user);
+}
+
+unsigned long long m9ThreadCycles() {
+  ULONG64 cycles = 0;
+  QueryThreadCycleTime(GetCurrentThread(), &cycles);
+  return cycles;
+}
